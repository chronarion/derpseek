# Derpseek lossy-fast (called exact-fast before 1.4): the exact profile's expert tiers plus dsv41's fast-profile options,
# which are lossy (singleton drop-2 inside the decode graphs, MXFP8 verify head) or speed-only (router to 64 rows,
# decode graphs to batch 16). Decode-path KLD 0.028 (dsv41 measured these options at ~0.034, 0.039 at batch 16).
# the lossy profiles keep the rowmap they were measured with (1.4 / 1.6); exact moved to a varied-text rowmap in 1.8
# and to 6-bit scale codes in 1.9 (not measured with these options: off here; DERPSEEK_SF6=1 with a larger rowmap works)
: "${ROWMAP:=exact-splitA-mm.json}"
: "${DERPSEEK_SF6:=0}"
: "${DERPSEEK_EMBED_HOST:=0}"
: "${DERPSEEK_DRAFT_SHAPE=}"    # 1.10: the draft reshape is off here (not measured with these options)   # 1.10: the embedding table stays in GPU memory here (not measured with these options)
. "$(dirname "${BASH_SOURCE[0]}")/exact.env"
export DSV41_ROUTER_MEGA_MAX_T=64
export DERPSEEK_WIDE_B1_STOCK=0   # the singleton drop runs in the 32-row copy verify too (it needs the W4 router there)
export DSV41_TOPK_DROP=12
export DSV41_DROP_DECODE_ONLY=1
export DSV41_HEAD_FP8=dg
export DSV41_WS_MAX_BATCH=16
