# Derpseek deferred-fast (experimental): lossy-fast, and an expert that is not in GPU memory is never skipped and its
# read never sits inside the layer's MoE call: in layers 20-38 every such pick is computed by a late lane (a second MoE
# kernel on the 8 SMs the main one leaves free) beside the layer's MoE call, and its result joins one sublayer late
# (after the next layer's attention, before its FFN). At 1-8 and 17-64 rows per call; prompts and layers 0-19 / 39 as
# in lossy-fast. In our tests it is no faster than lossy-fast (the CPU-memory link is the limit, and the late window
# hides only an expert or two per layer); KLD 0.030. derpseek_engine/defer.py.
. "$(dirname "${BASH_SOURCE[0]}")/lossy-fast.env"
export DERPSEEK_MISS=defer
export DERPSEEK_MISS_LAYERS=${DERPSEEK_MISS_LAYERS:-20-38}
