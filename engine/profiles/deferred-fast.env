# Derpseek deferred-fast: lossy-fast, and a decode step never waits for an expert in CPU memory and never skips one:
# in layers 20-38 every pick of an expert that is not in GPU memory is computed by a late lane (a second MoE kernel on
# the 8 SMs the main one leaves free) beside the layer's MoE call, and its result joins one sublayer late (after the
# next layer's attention, before its FFN). Prompt reading and layers 0-19 / 39 stay as in lossy-fast. Up to 8 rows per
# call for now (one request with three drafts, or two). derpseek_engine/defer.py.
. "$(dirname "${BASH_SOURCE[0]}")/lossy-fast.env"
export DERPSEEK_MISS=defer
export DERPSEEK_MISS_LAYERS=${DERPSEEK_MISS_LAYERS:-20-38}
