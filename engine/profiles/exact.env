# Derpseek exact (the default): the GB300 alone, every expert exact. Per layer 224 (layers 0-19) or 160 (20-39) static
# experts (hot in every calibration family) + 96 cache rows in HBM; every non-static expert also keeps a host row in
# pinned host memory that MegaMoE reads over NVLink-C2C when it is not cached. Official precision throughout (FP4
# experts, FP8 / BF16 elsewhere, the BF16 verify head). Every option here is lossless (bitwise or FP32-summation-order
# class) or distribution-preserving (it changes only the drafts and so the acceptance, never the output distribution).
# dsv41's fastpath components (ds41, MIT) run on the GB300; there is no RTX sidecar.
# 1.9: 6-bit scale codes (derpseek_engine/sf6.py, the MegaMoE fork's namespace derpseek_sf6). Every routed expert's
# UE8M0 scales (117..127 in this checkpoint) are stored as scale - 96 in 6 bits: HBM rows, cache rows, host rows and
# staging slots alike. The kernel loads them with the TMA's 6-bit type, the scale copy's 6-bit form unpacks them into
# tensor memory, and the token scales carry the 96 instead: bit-identical outputs (tests with SF6=1). An expert row
# is 1.47% smaller, and the 2.97 GiB this frees holds 8 more static experts in each of layers 20-39 (the rowmap below).
# Against 1.8: the bench's teacher-forced batch-16 replay -4.0% time, unrelated conversations +4-8%, lil-bench and
# prompt reading the same.
# DERPSEEK_SF6=0: 1.8's uncoded rows and rowmap.
# 1.10: the target's input embedding table (1.23 GiB) lives in pinned Grace memory and is read in place
# (derpseek_engine/hbm.py: the same rows bit for bit; an 8K-token prompt chunk gathers them in 0.5 ms); the room holds 3
# more static experts in each of layers 20-39 (171 + 96). Against 1.9 in one session: unrelated conversations 8 / 16
# +6% / +4%, lil C1 the same, KV pool 2.76M tokens (2.68M). DERPSEEK_EMBED_HOST=0 + ROWMAP=exact-splitA-varied-sf6-mm.json
# is 1.9's layout.
export DERPSEEK_EMBED_HOST=${DERPSEEK_EMBED_HOST:-1}
export DERPSEEK_SF6=${DERPSEEK_SF6:-1}
if [ "$DERPSEEK_SF6" = 1 ]; then
  if [ "$DERPSEEK_EMBED_HOST" = 1 ]; then
    ROWMAP=${ROWMAP:-exact-splitA-varied-sf6-s171-mm.json}   # 1.10: 171 static + 96 cache in layers 20-39
  else
    ROWMAP=${ROWMAP:-exact-splitA-varied-sf6-mm.json}   # 1.9: as 1.8's below with 168 static (was 160) + 96 cache in layers 20-39
  fi
else
  ROWMAP=${ROWMAP:-exact-splitA-varied-mm.json}   # 1.8: split A (layers 0-19: 224 static + 96 cache, 20-39: 160 + 96), static sets ranked max-min over eleven kinds of text (held-out windows of the bench's varied corpus + the KLD corpus): decode ~3.5% faster on the bench's teacher-forced batch-16 replay, the same elsewhere (1.2-1.7: exact-splitA-mm.json, 18 KLD windows)
fi
FASTPATH=megamoe,fastload,attn,preattn,preattn_cand,preattn_index,preattn_compress,lowb_aux,tail_swa_meta,tail_replay_skip,tail_embed,tail_ctxkv,tail_proj_side,topp_fast,tail_drafthead_mxfp8,tail_draft_embed,boundary,w8oproj,tail_markov_fused,engram_side
# DSpark drafts 7 per step; batch-1 steps verify 5 or 7 of them by expected tokens per unit of step time (dynk.py),
# or 31 copied tokens when the request's history repeats (suffix.py); batches of 2-4 verify 5, larger batches 3.
SPEC='{"method":"dspark","num_speculative_tokens":31,"num_speculative_tokens_per_batch_size":[[1,1,31],[2,4,5],[5,8,3],[9,32,3]],"draft_sample_method":"probabilistic","rejection_sample_method":"block"}'
export DSV41_MXFP8_OUT=1          # G2: the seams write the MXFP8 activations the next GEMM reads (bitwise)
export DSV41_LL_GEMM=1            # G3: low-latency MXFP8 GEMM tactics for M <= 8 (split-K: FP32-order class)
export DSV41_LL_WIDE=1            # I6: the same low-latency kernel with 16/32-row tiles for 8 < M <= 32 (batch 2-4, the 32-row
                                  #     copy verify; vLLM #63921): -4..-5% step there, FP32-order class
export DSV41_LL_WIDE_MAX=64       #     and 48/64-row tiles up to M = 64 (batch 9-16 at 3 drafts): 16 requests +1.3%
export DSV41_PROJ_SIDE_CAPTURE=1  # G4: the drafter's main projection on a side stream inside the step graph
export DSV41_SHARED_PF=1          # B1: the router's CTAs prefetch the layer's shared expert into L2 while HBM is idle
                                  #     (before their dependency wait; cache policy only): batch-1 step -0.4..-0.9%
export DSV41_DFLASH_PREP=1        # H15: the drafter's input prep pads in parallel (bitwise)
export DSV41_REPLAY_SKIP=1        # S60 / A4: intermediate prefill chunks skip the decoder replay nothing reads: prefill +9.5%
                                  #           at 32K-128K (replay_skip.py)
export DSV41_DYNK=0               # K3b below replaces S27's 5 or 7 drafts per batch-1 step (dynk.py)
# DERPSEEK_DRAFT_SHAPE=/derpseek/draft_shape/shape-v1.json (opt-in, 1.10): a context-free reshape of the drafter's
# proposal in the fused Markov kernel (exact: draft-only), K3b fed the drafter's own confidences (draftshape.py).
# Served A/B on lil C1: accepted tokens per step +1.4%, tok/s +0.6% (within noise: the kernel's extra barrier costs ~0.7%).
export DSV41_CONF_WIDTH=0.3       # K3b: the batch-1 verify width comes from the current drafts' confidences, one step graph per
export DSV41_CONF_WIDTH_MODE=graphs   # width (conf_width.py, runner.py): prose c=1 +3..+8% over DynK, distribution-preserving
export DSV41_CONF_WIDTH_B=0.25    # K3: per-request widths at batch >= 2 as masked verify rows: prose c=2 +2%, c=4 +6%
export DSV41_ROUTER_MEGA=1        # I19: the W4 router at T 17-64 (bit-exact with the stock gate): masked verify rows skip their
export DSV41_ROUTER_MEGA_MAX_T=64 #      MoE work only through it. 1.5: 64 (was 24): batch 7-16 verify steps get the masked rows
export DERPSEEK_WIDE_B1_STOCK=1   #      and R1 (C8 +6%); the batch-1 32-row copy verify stays on the stock path (1x31 10.9 vs
                                  #      11.3 ms): calls of more than 24 rows take the W4 router only as masked verify steps
export DSV41_SUFFIX=1             # G6: copy drafting with a 32-row verify at batch 1 (suffix.py)
export DSV41_DSPARK_K=7
export DSV41_WARM_ADAPT=0          # dsv41's warm slots (cold experts mirrored in HBM for prompts): none on the GB300 alone
export DSV41_WHOLE_STEP=1        # C4: each decode step replays one captured CUDA graph (runner.py)
export DSV41_WS_MAX_BATCH=16      # 1.5: whole-step graphs to batch 16 (dsv41's default stops at 8): with the router above, C16 +8.5%
export DERPSEEK_MODE=exact
export DERPSEEK_STAGE=${DERPSEEK_STAGE:-1}   # 1.4: prompt staging (derpseek_engine/prefill.py): while a prompt chunk computes a
                                  # layer, the host-mapped experts of the layer two ahead are copied into a 2.4 GB GPU staging
                                  # area (one batched copy at ~350 GB/s), so its MoE reads them from HBM; bit-exact
                                  # (tests/stage_test.py). Varied-text prompts +31-36% (same boot, staging switched live;
                                  # lil's repeating text +3%, release-check prompts +31%); the KV cache gives up the 2.4 GB
                                  # (3.66M -> 2.60M tokens). DERPSEEK_STAGE=0 turns it off.
export DSV41_R1=1                 # MegaMoE starts on the router's ready flag instead of the router grid's completion (dsv41
                                  # closed it: its gain moved into the RTX ack wait; with no peer it stays): batch-1 steps
                                  # -0.5..-1.2%. With it, the no-peer combine in the next seam (DERPSEEK_SEAM_COMBINE, on)
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.98}   # 1.3: the ~10 GiB vLLM left unused at 0.96 goes to the KV cache (1.46M -> 3.66M tokens); release checks pass, same speed
