# Derpseek exact-fast: exact mode plus dsv41's fast-profile options (singleton drop-2 inside the decode graphs, MXFP8
# verify head, decode graphs to batch 16). Speed first; dsv41 measured these at decode KLD ~0.034 (0.039 at batch 16).
. "$(dirname "${BASH_SOURCE[0]}")/exact.env"
export DSV41_ROUTER_MEGA_MAX_T=64
export DSV41_TOPK_DROP=12
export DSV41_DROP_DECODE_ONLY=1
export DSV41_HEAD_FP8=dg
export DSV41_WS_MAX_BATCH=16
