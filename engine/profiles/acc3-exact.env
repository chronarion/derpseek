# Measurement only (C1 push, 11-22): exact with every batch-1 step verifying all 7 DSpark drafts, no copy drafting, no
# dynamic width, eager steps (the acceptance logger runs Python per step). Not a serving profile.
. "$D/profiles/exact.env"
SPEC='{"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"probabilistic","rejection_sample_method":"block"}'
export DSV41_SUFFIX=0 DSV41_DYNK=0 DSV41_CONF_WIDTH=0 DSV41_CONF_WIDTH_B=0 DSV41_WHOLE_STEP=0 DSV41_DSPARK_K=7
export DERPSEEK_ACC3=/root/.cache/vllm/acc3.jsonl
