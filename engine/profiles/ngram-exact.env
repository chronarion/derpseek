# Measurement only (C1 push): exact with vLLM's n-gram (prompt lookup) drafter instead of DSpark: the class of drafter
# the Grace CPU could run without the target's features (Carbon round 1 L3). Whole-step graphs, K3b and the copy
# drafter are DSpark-specific and off. Not a serving profile.
. "$D/profiles/exact.env"
SPEC='{"method":"ngram","num_speculative_tokens":4,"prompt_lookup_max":4,"prompt_lookup_min":2}'
export DSV41_SUFFIX=0 DSV41_DYNK=0 DSV41_CONF_WIDTH=0 DSV41_CONF_WIDTH_B=0 DSV41_WHOLE_STEP=0 DERPSEEK_DRAFT_SHAPE=
