# Derpseek exact-fast-kv: exact-fast with a 3.6M-token KV cache (exact-fast: 1.44M). The GPU memory vLLM leaves unused at
# --gpu-memory-utilization 0.96 (~10 GiB) goes to the KV cache instead, leaving ~5 GiB of headroom. Enough for every
# cell of lil-bench standard/1 (16 requests at 128K need 2.13M tokens); in that run decode was 1-5% below exact-fast.
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.98}
. "$(dirname "${BASH_SOURCE[0]}")/exact-fast.env"
