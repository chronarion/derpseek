# Derpseek skip-fast: exact-fast, but a miss costs precision instead of time. A pick whose expert is not in HBM this
# step (a host row) is dropped for that step in layers 20-38 instead of read over NVLink-C2C; it still counts as a miss,
# so the residency manager promotes the expert for the next steps. Prompt prefill and layers 0-19 / 39 stay exact.
. "$(dirname "${BASH_SOURCE[0]}")/exact-fast.env"
export DERPSEEK_MISS=skip
export DERPSEEK_MISS_LAYERS=${DERPSEEK_MISS_LAYERS:-20-38}
